{
  "name": "api_gastos",
  "version": "1.0.0",
  "main": "src/main.js",
  "scripts": {
    "test": "jest",
    "start": "node --env-file=.env src/main.js",
    "dev": "node --watch --env-file=.env src/main.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "migrate": "node --env-file=.env node_modules/node-pg-migrate/bin/node-pg-migrate.js",
