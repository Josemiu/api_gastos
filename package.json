    "test:coverage": "jest --coverage"
  },
  "license": "MIT",
  "description": "API REST de gastos y presupuestos con arquitectura hexagonal",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1",
    "swagger-ui-express": "^5.0.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "jest": "^30.5.2",
    "node-pg-migrate": "^9.0.0",
    "prettier": "^3.10.1",
    "supertest": "^7.3.2"
  },
  "engines": {
    "node": ">=22"
  },
  "private": "true"
