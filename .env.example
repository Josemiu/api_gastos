NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://gastos:gastos@localhost:5433/gastos
# Mínimo 32 caracteres. Genera uno propio, por ejemplo con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=1h
# Solo para las pruebas con base de datos (npm run test:db). Usa un esquema temporal.
TEST_DATABASE_URL=postgres://gastos:gastos@localhost:5433/gastos
